{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customGradient": true,
      "palette": [
        {
          "slug": "primary",
          "color": "#CCFF00",
          "name": "Primary (KM Yellow)"
        },
        {
          "slug": "secondary",
          "color": "#33ABC6",
          "name": "Secondary (KM Blue)"
        },
        {
          "slug": "km-blue",
          "color": "#33ABC6",
          "name": "KM Blue"
        },
        {
          "slug": "km-yellow",
          "color": "#CCFF00",
          "name": "KM Yellow"
        },
        {
          "slug": "dark-gray",
          "color": "#3F3F3F",
          "name": "Dark Gray"
        },
        {
          "slug": "light-gray",
          "color": "#C3C3C3",
          "name": "Light Gray"
        },
        {
          "slug": "background-gray",
          "color": "#F6F6F6",
          "name": "Background Gray"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "navi",
          "color": "#051C2C",
          "name": "Navi"
        }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "vh", "vw"]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Instrument Sans\", sans-serif",
          "name": "Instrument Sans",
          "slug": "instrument-sans"
        }
      ]
    },
    "layout": {
      "contentSize": "984px",
      "wideSize": "1400px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--black)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--instrument-sans)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h1": {
        "typography": {
          "fontWeight": "bold"
        }
      },
      "h2": {
        "typography": {
          "fontWeight": "bold"
        }
      },
      "h3": {
        "typography": {
          "fontWeight": "bold"
        }
      },
      "h4": {
        "typography": {
          "fontWeight": "bold"
        }
      },
      "h5": {
        "typography": {
          "fontWeight": "bold"
        }
      },
      "h6": {
        "typography": {
          "fontWeight": "bold"
        }
      }
    }
  }
}
